# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and is loaded automatically by docker compose.

# Rails encrypted-credentials key.
# Either commit your team's `config/master.key` to your local checkout
# (it is bind-mounted into the container) or uncomment and set this:
# RAILS_MASTER_KEY=

# Override Postgres credentials if you don't want the compose defaults
# (postgres / postgres / keystone_development).
# DATABASE_URL=postgres://postgres:postgres@db:5432/keystone_development

# solid_queue worker concurrency (used only when the `jobs` profile is up).
# JOB_CONCURRENCY=1
